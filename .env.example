# Optional fallback for your name. The app asks for it the first time you
# open it (the First Light intro) and saves it in the database, which wins.
USER_NAME=

# OpenAI API Key (for embeddings - always required)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude extraction - cheaper!)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Extraction Model (claude-haiku, claude-sonnet, or gpt-4o)
# Recommended: claude-haiku (cheapest current Claude model)
# Note: claude-haiku -> claude-haiku-4-5-20251001, claude-sonnet -> claude-sonnet-5
EXTRACTION_MODEL=claude-haiku

# Model that answers questions typed into Home's search bar
ANSWER_MODEL=claude-sonnet-5-5

# Optional: your portfolio site, linked from Home (see docs/PORTFOLIO.md).
# Leave blank to hide the link.
VITE_PORTFOLIO_URL=

# Server Port
PORT=3001
